filters:
  and:
    - file.inFolder("_crosswalker/mappings/cri-to-800-53")
    - file.ext == "md"
properties:
  subject_id:
    displayName: 800-53 control
  object_id:
    displayName: CRI obligation
  predicate_id:
    displayName: STRM relation
  match_confidence:
    displayName: Confidence
views:
  - type: crosswalker-pivot
    name: 800-53 family × CRI group
    rowsBy: subject_group
    colsBy: object_group
    cellOp: count
    empty: gap
    heatmap: true
    rowSort: asc
    colSort: asc
  - type: table
    name: Edges (detail)
    order:
      - subject_id
      - predicate_id
      - object_id
      - match_confidence

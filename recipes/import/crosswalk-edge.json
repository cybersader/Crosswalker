        "managed": {
          "subject_id": "{subject_id}",
          "predicate_id": "{strm_predicate}",
          "object_id": "{object_id}",
          "match_confidence": "{match_confidence}",
          "mapping_justification": "{mapping_justification}",
          "mapping_provider": "{mapping_provider}",
          "sssom_predicate": "{sssom_predicate}"
        }
      }
    }
  }
}
